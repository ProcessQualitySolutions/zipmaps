{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Heat-number map item (rectangular callout)",
  "type": "object",
  "zipmap": { "geometry": "rect" },
  "required": ["id", "x", "y", "x2", "y2"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "x": { "type": "number" },
    "y": { "type": "number" },
    "x2": { "type": "number" },
    "y2": { "type": "number" },
    "heat_number": { "type": "string" },
    "material_spec": { "type": "string" },
    "mtr": { "type": "string" }
  },
  "additionalProperties": true
}
