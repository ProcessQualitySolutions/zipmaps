{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Flange map item",
  "type": "object",
  "zipmap": { "geometry": "flag" },
  "required": ["id", "x", "y", "x2", "y2"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "x": { "type": "number" },
    "y": { "type": "number" },
    "x2": { "type": "number" },
    "y2": { "type": "number" },
    "size": { "type": "string" },
    "rating": { "type": "string" },
    "gasket": { "type": "string" },
    "torque_spec": { "type": "string" },
    "status": { "type": "string" },
    "date": { "type": "string" }
  },
  "additionalProperties": true
}
