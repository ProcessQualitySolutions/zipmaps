{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Weld map item",
  "type": "object",
  "zipmap": { "geometry": "flag" },
  "required": ["id", "x", "y", "x2", "y2"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "x": { "type": "number" },
    "y": { "type": "number" },
    "x2": { "type": "number" },
    "y2": { "type": "number" },
    "size": { "type": "string" },
    "schedule": { "type": "string" },
    "material": { "type": "string" },
    "weld_type": { "type": "string" },
    "welder": { "type": "string" },
    "wps": { "type": "string" },
    "nde": { "type": "string" },
    "date": { "type": "string" }
  },
  "additionalProperties": true
}
